  ],
  "release": {
    "github": "TechnicallyComputers/BombermanPartyEditionRecomp",
    "asset_glob": {
      "linux": "*linux*",
      "windows": "*windows*",
      "macos": "*macos*"
    }
  },
  "build": {
    "enabled": true,
    "source": {
      "github": "TechnicallyComputers/BombermanPartyEditionRecomp",
      "ref": "main"
    },
    "sdk": {
      "id": "psxrecomp-tools",
      "github": "TechnicallyComputers/BombermanPartyEditionRecomp",
      "asset_glob": {
        "linux": "*psxrecomp-tools*linux*",
        "windows": "*psxrecomp-tools*windows*",
        "macos": "*psxrecomp-tools*macos*"
      }
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "TechnicallyComputers/retcomm-toolchains",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "engine": "psxrecomp",
      "config": "game.toml"
    },
    "cmake": {
      "build_dir": "build-release",
      "target": "psx-runtime",
      "config": "Release"
    }
  },
  "install_dir_name": "BombermanPartyEditionRecomp",
  "launch": {
    "linux": "Bomberman_Party_Edition_Recompiled",
    "windows": "Bomberman_Party_Edition_Recompiled.exe",
    "macos": "Bomberman_Party_Edition_Recompiled"
  },
  "romm": {
    "platforms": [
      "ps",
      "psx",
      "ps1"
    ]
  },
  "saves": {
    "memcard_glob": [
      "saves/*.mcd",
      "saves/*.mcr",
      "*.mcd",
      "*.mcr"
    ]
  },
  "netplay": {
    "supported": true,
    "stack": "recomp-net",
    "game_name": "Bomberman Party Edition",
    "game_version": "0.1.0",
    "max_slots": 5,
    "transports": ["lan", "ice"],
    "match_caps_schema": "psx-v1"
  },
  "notes": "Disc serial SLUS-01189 / boot EXE SLUS_011.89. Local build: psxrecomp_cli.py generate + cmake (toolchain from TechnicallyComputers/retcomm-toolchains). Setup host zips omit game C; RetComM prefers method=build when recipe enabled. Packages never ship disc/BIOS."
