{
  "id": "metal-warriors-snes",
  "name": "Metal Warriors",
  "kind": "recomp",
  "platform": "snes",
  "description": "SNES recomp of Metal Warriors (USA) on snesrecomp.",
  "homepage": "https://github.com/TechnicallyComputers/MetalWarriorsSNESRecomp",
  "rom_identity": {
    "crc32": [
      "f2ab92d4"
    ],
    "md5": [
      "1b1282421d39a473f634958c28dca0d4"
    ],
    "sha1": [
      "bcf0a4d5370547c9d6e5317210e12bdea3994f15"
    ],
    "sha256": [
      "0d7f875877fe856066cfb39b4ecdbbe7d48393a75770720876c94419f809bb1c"
    ],
    "disc_serials": [],
    "sizes": [],
    "filenames": [
      "Metal Warriors (USA).sfc"
    ]
  },
  "rom_extensions": [
    ".sfc",
    ".smc",
    ".fig",
    ".swc"
  ],
  "release": {
    "github": "TechnicallyComputers/MetalWarriorsSNESRecomp",
    "allow_prerelease": true,
    "asset_glob": {
      "linux": "*linux*",
      "windows": "*windows*",
      "macos": "*macos*"
    }
  },
  "build": {
    "enabled": true,
    "source": {
      "github": "TechnicallyComputers/MetalWarriorsSNESRecomp",
      "ref": "v0.1.0"
    },
    "sdk": {
      "id": "snesrecomp-tools",
      "github": "TechnicallyComputers/MetalWarriorsSNESRecomp",
      "asset_glob": {
        "linux": "*snesrecomp-tools*linux*",
        "windows": "*snesrecomp-tools*windows*",
        "macos": "*snesrecomp-tools*macos*"
      }
    },
    "toolchain": {
      "id": "cmake-clang-v1",
      "github": "TechnicallyComputers/retcomm-toolchains",
      "asset_glob": {
        "linux": "*cmake-clang-v1*linux*",
        "windows": "*cmake-clang-v1*windows*",
        "macos": "*cmake-clang-v1*macos*"
      }
    },
    "generate": {
      "cfg_dir": "recomp",
      "out_dir": "src/gen",
      "funcs_h": "recomp/funcs.h",
      "cfg_roots": true
    },
    "cmake": {
      "build_dir": "build",
      "target": "MetalWarriorsSNESRecomp",
      "config": "Release"
    }
  },
  "install_dir_name": "MetalWarriorsSNESRecomp",
  "launch": {
    "linux": "MetalWarriorsSNESRecomp",
    "windows": "MetalWarriorsSNESRecomp.exe",
    "macos": "MetalWarriorsSNESRecomp"
  },
  "romm": {
    "platforms": [
      "snes"
    ]
  },
  "saves": {
    "sram_glob": [
      "*.srm",
      "saves/*.srm"
    ]
  },
  "netplay": {
    "supported": true,
    "stack": "recomp-net",
    "game_name": "Metal Warriors",
    "game_version": "0.1.0",
    "max_slots": 2,
    "transports": ["lan", "ice"],
    "match_caps_schema": "snes-v1"
  },
  "notes": "Primary install is catalog build (generate + cmake) via snesrecomp-tools + cmake-clang-v1 packs; prebuilt metalwarriors-{linux,windows,macos}-*.zip remains as fallback. Lobby pin from VERSION (0.1.0)."
}
